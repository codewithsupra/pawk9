// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Pet {
  id         String   @id @default(cuid())
  name       String
  ownerName  String
  imageUrl   String?
  age        Int
  notes      String?
  // How to reach the owner (used for sending them updates). Both optional; the phone is
  // stored with spaces and punctuation stripped, e.g. "+14155552671".
  ownerEmail String?
  ownerPhone String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Every pet belongs to a user. Deleting a user deletes their pets.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stays      Stay[]
  photos     Photo[]
  photoSends PhotoSend[]
  bookings   Booking[]

  // Secret code in the pet's public booking link (/book/<code>). Random and unguessable,
  // created the first time the daycare asks for the link; null until then. Stored (not a
  // signed token) so a link can be switched off by clearing it.
  bookingCode String? @unique

  @@index([userId])
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Set once the one-time lifetime purchase is paid (see src/lib/purchases.ts). Null
  // means no lifetime access.
  lifetimePurchasedAt     DateTime?
  // The Stripe Checkout Session that paid for it. Unique, so replaying the same
  // payment event can never grant it twice.
  lifetimeStripeSessionId String?   @unique

  // What this daycare charges per day, in cents, for online bookings. Null means the
  // daycare hasn't set a rate, so it can't take bookings yet.
  dailyRateCents Int?

  // This daycare's Stripe Connect (Express) account, where booking payments are sent.
  // Created the first time they click Connect. Unique so one Stripe account can't be
  // attached to two daycares.
  stripeAccountId      String? @unique
  // Whether Stripe says that account can take card payments (checked with Stripe, then
  // remembered here so public pages don't need to call Stripe on every view).
  stripeChargesEnabled Boolean @default(false)

  pets       Pet[]
  stays      Stay[]
  photos     Photo[]
  photoSends PhotoSend[]
  bookings   Booking[]
}

// One visit: a pet checked in, and (once they leave) checked out. A pet is "checked in"
// while it has a stay with no checkedOutAt. At most one stay per pet may be open at a
// time; SQLite can't express that in the schema, so checkInPet enforces it.
model Stay {
  id           String    @id @default(cuid())
  checkedInAt  DateTime  @default(now())
  checkedOutAt DateTime?

  petId  String
  pet    Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  // Denormalised from the pet so every query can be scoped to the signed-in user.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([petId, checkedInAt])
  @@index([userId, checkedOutAt])
}

// A photo of a pet. The image itself is not in the database: `key` says where it lives in
// the storage backend (src/lib/storage.ts), and files are only ever served through a route
// that checks the viewer owns the pet.
model Photo {
  id          String   @id @default(cuid())
  // Generated by the server, never taken from user input, so it is safe to use as a path.
  key         String   @unique
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  petId  String
  pet    Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  // Denormalised from the pet so every query can be scoped to the signed-in user.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sends PhotoSend[]

  @@index([petId, createdAt])
  @@index([userId])
}

// One email of a photo to the pet's owner. Kept so the UI can show "Sent" and so sending
// can be limited. The recipient's address is deliberately not stored here.
model PhotoSend {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  photoId String
  photo   Photo   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet     Pet?    @relation(fields: [petId], references: [id])
  petId   String?

  @@index([photoId, createdAt])
  @@index([userId, createdAt])
}

enum BookingStatus {
  // Created, waiting for the owner to pay. Not a reservation yet.
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

// A pet's booked stay: every day from startDate to endDate inclusive. Money fields are
// snapshots taken when the booking is made, so later rate changes never alter it.
model Booking {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Calendar days stored at UTC midnight; times of day don't matter for a daycare.
  startDate      DateTime
  endDate        DateTime
  days           Int
  dailyRateCents Int
  amountCents    Int
  status         BookingStatus @default(PENDING_PAYMENT)

  petId  String
  pet    Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  // The daycare that owns the pet, denormalised so every query can be scoped to it.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@index([petId])
}
