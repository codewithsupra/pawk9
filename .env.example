# Copy to .env and fill in. Never commit real values.

# Postgres. Locally: postgresql://<your-os-user>@localhost:5432/pawk9_dev
DATABASE_URL=
# Non-pooled connection, used for migrations (needed with Neon; optional locally)
DIRECT_DATABASE_URL=

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe (test keys). The webhook secret comes from `stripe listen`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Signs the photo links sent to owners. 32+ random characters, different per environment.
PHOTO_LINK_SECRET=

# Resend email. RESEND_FROM must be on a verified domain; leave it empty to use
# Resend's test sender (only delivers to your own Resend account email).
RESEND_API_KEY=
RESEND_FROM=

# Production only
APP_URL=
CONTACT_EMAIL=
BLOB_READ_WRITE_TOKEN=
